# RISKGRAPH Environment Configuration Example

# Backend API Configuration
PROJECT_NAME="RISKGRAPH Engine"
VERSION="0.1.0"
API_V1_STR="/api/v1"
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
DEBUG=True

# CORS Settings
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=riskgraph_user
POSTGRES_PASSWORD=riskgraph_secret
POSTGRES_DB=riskgraph_db
DATABASE_URL=postgresql://riskgraph_user:riskgraph_secret@localhost:5432/riskgraph_db

# Frontend Environment Variables
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
